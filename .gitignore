.vscode/

# Java / JVM
*.class
hs_err_pid*
replay_pid*

# Signing material — never commit private keys or keystores
*.keystore
*.jks
*.p12
# Exception: the debug keystore is intentionally committed. It is non-sensitive
# (well-known android/android credentials, debug-only) and shared so every build
# has one signature. It CANNOT sign release builds — the release key stays in CI secrets.
!app/debug.keystore
*.pfx

# Secrets
.env
.device-token

# Python (dev tooling)
.venv/
__pycache__/
*.pyc

# Logs
*.log
dev/logs/

# OS
.DS_Store
Thumbs.db
